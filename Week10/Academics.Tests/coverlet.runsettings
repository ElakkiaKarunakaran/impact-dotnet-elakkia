<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <!-- Task 10.3 — EF migrations are scaffold-generated (dotnet ef migrations add),
               not hand-written business logic; excluded from the coverage gate like the
               Reporting view-backed endpoint and Identity's ADO.NET repository. -->
          <ExcludeByFile>**/Migrations/*.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
