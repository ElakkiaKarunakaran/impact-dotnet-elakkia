{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "Jwt": {
    "Key":      "Week10CapstoneSuperSecretKey_PortalMicroservices_2026!",
    "Issuer":   "Week10.Identity",
    "Audience": "Week10.Portal"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },

  "ReverseProxy": {
    "Routes": {
      "identity-auth-route": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/identity/api/auth/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/identity" } ]
      },
      "academics-route": {
        "ClusterId": "academics-cluster",
        "AuthorizationPolicy": "RequireAuth",
        "Match": { "Path": "/academics/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/academics" } ]
      },
      "reporting-route": {
        "ClusterId": "reporting-cluster",
        "AuthorizationPolicy": "RequireAuth",
        "Match": { "Path": "/reporting/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/reporting" } ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "d1": { "Address": "http://identity:8080/" }
        }
      },
      "academics-cluster": {
        "Destinations": {
          "d1": { "Address": "http://academics:8080/" }
        }
      },
      "reporting-cluster": {
        "Destinations": {
          "d1": { "Address": "http://reporting:8080/" }
        }
      }
    }
  },

  "AllowedHosts": "*"
}
